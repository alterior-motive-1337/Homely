{
  "name": "homely",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env --import tsx scripts/restore.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "prebuild": "node scripts/vendor-chat.mjs",
    "predev": "node scripts/vendor-chat.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "exa-js": "^2.25.0",
    "libsql": "^0.5.29",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "openai": "7.23.0",
    "pdfjs-dist": "6.4.299"
  }
}
